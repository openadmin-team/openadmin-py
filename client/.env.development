# Dev-only: this client normally self-detects its API base from the URL it's
# served from (see src/api/client.ts), which only works once AdminPanel itself
# serves the built SPA. `bun run dev` serves the SPA from Vite instead, so
# point it at the mount prefix + origin your local backend uses.
VITE_API_BASE=/admin
VITE_DEV_BACKEND_URL=http://localhost:8000
