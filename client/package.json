		"@tanstack/vue-query": "^5.101.4",
		"@tanstack/vue-table": "^9.1.2",
		"@unovis/vue": "^1.6.7",
		"@vueuse/core": "^14.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.13",
		"marked": "^18.0.9",
