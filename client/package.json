{
	"name": "client",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"fix:format": "biome format --write .",
		"fix:lint": "biome lint --write --unsafe .",
		"fix": "bun run fix:format && bun run fix:lint",
